{
  "name": "fortiva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.supabase.config.ts",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts",
    "deploy:meal-photo": "npx supabase functions deploy analyze-meal-photo --project-ref sylkxxfnvmqbxbopshix --no-verify-jwt",
    "deploy:training": "npx supabase functions deploy generate-training-plan --project-ref sylkxxfnvmqbxbopshix --no-verify-jwt",
    "deploy:chat": "npx supabase functions deploy assistant-chat --project-ref sylkxxfnvmqbxbopshix --no-verify-jwt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.8",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
